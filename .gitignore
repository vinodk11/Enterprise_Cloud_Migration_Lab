# Local .terraform directories
**/.terraform/*
*.terraform*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Temporary files
*scripts-old*
*automation*

# OS files
.DS_Store
Thumbs.db


.scripts_*
