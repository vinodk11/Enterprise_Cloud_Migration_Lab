# -*- mode: ruby -*-
# vi: set ft=ruby :

# ==============================================================================
# Enterprise Cloud Migration Lab — DB01 (PostgreSQL Database Server)
# ==============================================================================

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202508.03.0"
  config.vm.hostname = "db01.corp.local"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Attach to custom libvirt network 'migration-lab'
  config.vm.network "private_network",
    ip: "10.10.10.30",
    libvirt__network_name: "migration-lab",
    mac: "52:54:00:10:10:30"

  config.vm.provider :libvirt do |lv|
    lv.cpus = 2
    lv.memory = 2048
    lv.storage_pool_name = "vm-storage"
  end

  # Provision 1: Base credentials & Netplan static IP binding
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    echo "[PROVISION] Setting up labadmin credentials..."
    if ! id -u labadmin >/dev/null 2>&1; then
      useradd -m -s /bin/bash labadmin
    fi
    echo 'labadmin:LabAdmin2026!#' | chpasswd || true
    usermod -aG sudo labadmin
    echo "labadmin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/labadmin
    chmod 0440 /etc/sudoers.d/labadmin

    sed -i 's/^#\\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    sed -i 's/^#\\?KbdInteractiveAuthentication .*/KbdInteractiveAuthentication yes/' /etc/ssh/sshd_config
    systemctl reload ssh || systemctl restart ssh || systemctl restart sshd

    echo "[PROVISION] Binding static IP 10.10.10.30/24..."
    cat << 'EOF' > /etc/netplan/60-migration-lab.yaml
network:
  version: 2
  renderer: networkd
  ethernets:
    id-lab:
      match:
        macaddress: "52:54:00:10:10:30"
      addresses:
        - 10.10.10.30/24
      nameservers:
        addresses: [1.1.1.1, 10.10.10.10]
EOF
    chmod 600 /etc/netplan/60-migration-lab.yaml
    netplan apply || true
    echo "[PROVISION] Base DB01 setup complete."
  SHELL

  # Provision 2: Role Setup Script (PostgreSQL)
  config.vm.provision "shell", path: "configure-db01.sh"
end
