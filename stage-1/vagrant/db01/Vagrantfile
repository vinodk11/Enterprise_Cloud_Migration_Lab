# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.hostname = "DB01.corp.streamflix.lab"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.network "public_network", bridge: "vSwitch-Internal-NAT"

  config.vm.provider "hyperv" do |v|
    v.vmname = "DB01"
    v.cpus = 2
    v.memory = 2048
    v.mac = "00155D100030"
    v.auto_start_action = "Nothing"
    v.auto_stop_action = "ShutDown"
  end

  # Provision 1: Base user credentials & Static IP
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    echo "[PROVISION] Setting up labadmin credentials..."
    if ! id -u labadmin >/dev/null 2>&1; then
      useradd -m -s /bin/bash labadmin
    fi
    echo 'labadmin:LabAdmin2026!#' | chpasswd
    usermod -aG sudo labadmin
    echo "labadmin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/labadmin
    chmod 0440 /etc/sudoers.d/labadmin

    sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    sed -i 's/^#\?KbdInteractiveAuthentication .*/KbdInteractiveAuthentication yes/' /etc/ssh/sshd_config
    systemctl reload ssh || systemctl restart ssh || systemctl restart sshd

    echo "[PROVISION] Binding static IP 192.168.10.30/24..."
    ip addr add 192.168.10.30/24 dev eth0 2>/dev/null || true

    cat << 'EOF' > /etc/netplan/01-netcfg.yaml
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: false
      dhcp6: false
      addresses:
        - 192.168.10.30/24
      routes:
        - to: default
          via: 192.168.10.1
      nameservers:
        addresses: [192.168.10.10, 1.1.1.1]
EOF
    chmod 600 /etc/netplan/01-netcfg.yaml
    echo "[PROVISION] Base DB01 setup complete."
  SHELL

  # Provision 2: Role Setup Script (PostgreSQL Engine & Schema)
  config.vm.provision "shell", path: "configure-db01.sh"
end
